@page
@model BookReviews.Pages.CreateModel
@{
    ViewData["Title"] = "Create Book";
}

<h1>Create Book Submission</h1>
<hr />

<div class="row">
    <div class="col-6">
        <form class="" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group mb-2">
                <label asp-for="Book.Title" class="control-label"></label>
                <input asp-for="Book.Title" class="form-check-control" />
                <span asp-validation-for="Book.Title" class="text-danger"></span>
            </div>

            <div class="form-group mb-2">
                <label asp-for="Book.Author" class="control-label mr-2"></label>
                <input asp-for="Book.Author" class="form-check-control" />
                <span asp-validation-for="Book.Author" class="text-danger"></span>
            </div>

            <div class="form-group mb-2">
                <label asp-for="Book.Genre" class="control-label"></label>
                <input asp-for="Book.Genre" class="form-check-control" />
                <span asp-validation-for="Book.Genre" class="text-danger"></span>
            </div>

            <div class="form-group mb-2">
                <label asp-for="Book.Description" class="control-label"></label>
                <input asp-for="Book.Description" class="form-check-control" />
                <span asp-validation-for="Book.Description" class="text-danger"></span>
            </div>

            <div class="form-group mb-2">
                <label asp-for="Book.Rating" class="control-label"></label>
                <input asp-for="Book.Rating" class="form-check-control" />
                <span asp-validation-for="Book.Rating" class="text-danger"></span>
            </div>

            <div class="form-group mb-2">
                <label asp-for="Book.PublicationDate" class="control-label"></label>
                <input asp-for="Book.PublicationDate" class="form-check-control" />
                <span asp-validation-for="Book.PublicationDate" class="text-danger"></span>
            </div>

            <div class="form-group mt-2">
                <a asp-page="Index" class="btn btn-danger">Back</a>
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
@{
    await Html.RenderPartialAsync("_ValidationScriptsPartial");
}
}
